{
  // Type-checks the test code outside src/ as well.
  // CI runs `tsc --noEmit -p tsconfig.tests.json`, and ts-jest compiles every test with
  // it, because the base config's rootDir is ./src.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "."
  },
  "include": ["xmcp-env.d.ts", "src/**/*.ts", "tests/azure/**/*.ts"]
}
